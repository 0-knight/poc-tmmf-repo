# 읽기 전용 fork 테스트에 씁니다. 개인키 불필요.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 컨트랙트 verify와 cast source에 씁니다. etherscan.io/myapikey 에서 무료 발급.
ETHERSCAN_API_KEY=

# 실제 배포 시에만 필요합니다. anvil 로컬 테스트에는 불필요.
PRIVATE_KEY=

# 시연용 기간. 초 단위이고, 안 세우면 7일 / 1일 / 1일입니다.
#
# 기본값대로면 만기에서 청산까지 9일이 걸립니다. 로컬에서는 시간을 옮길 수 있지만
# Sepolia에서는 진짜로 기다려야 하므로, 한자리에서 보여주려면 분 단위로 줄이세요.
# 숫자를 줄여도 논리는 같습니다 — 사다리는 절대 시간이 아니라 비율로 돕니다.
#
# **빈 값으로 두지 마세요.** 지우거나 주석으로 두면 기본값이 쓰이지만,
# `MARKET_TERM=` 처럼 비워 두면 숫자로 못 읽어 배포가 되돌아갑니다.
#
# **forge test 에는 세우지 마세요.** 테스트가 7일과 1일을 박아 두고 있습니다.
#
# MARKET_TERM=1800               만기까지 30분
# MATURITY_NOTICE_WINDOW=300     상대방만 선언할 수 있는 창 5분 (0이면 창 없음)
# MATURITY_RAMP_DURATION=300     청산선이 0까지 내려가는 데 5분

# 시연용 금액. 사다리 한 칸의 단위이고, 안 세우면 100입니다.
#
# 단위는 개수입니다. wei가 아닙니다. SCALE_UNIT=20 이면 담보 20 WTGXX, 칸마다 예치
# 20 USDC 이고, 차입은 비율에서 나옵니다 — A 16, B 16, C 14.
#
# 기본값 100으로 사다리를 세우려면 대여자 셋이 100씩, 합쳐 300 USDC가 필요합니다.
# 샌드박스 잔고에 맞춰 줄이세요. 비율에서 끌어내므로 줄여도 LTV 여유는 그대로입니다.
#
# 위 기간 변수와 같은 주의가 붙습니다. 빈 값으로 두지 말고 아예 지우세요.
#
# SCALE_UNIT=20                  담보 20 WTGXX, 칸마다 예치 20 USDC

# 담보를 거는 차입자 A. runChain 이 이 주소로 담보 볼트를 만듭니다.
# 안 세우면 배포자 자신이 됩니다.
#
# BORROWER_ADDRESS=0x346F46403f0E2Cb7461b2C0fBc23921b99789Db7
